# prgraf environment variables (all optional — defaults are sensible).
# No model or API key is required; the graph and every score are deterministic.

# --- what to review ---------------------------------------------------------
# PRGRAF_REPO=.              # repo to graph (MCP server; defaults to cwd)
# PRGRAF_DB=                 # graph db path (default: <repo>/.prgraf/graph.db)
# PRGRAF_BASE=HEAD~1         # CLI default base ref
# PRGRAF_HEAD=HEAD           # CLI default head ref
# PRGRAF_OUTPUT=             # CLI: also write the report to this file
# PRGRAF_FAIL_ON=none        # CLI: exit non-zero at this severity (P0/P1/P2/none)

# --- indexing ---------------------------------------------------------------
# PRGRAF_MAX_INDEX_FILES=3000    # refuse scopes bigger than this (a folder of
#                                # many projects is usually a mistake)
# PRGRAF_MAX_FILE_BYTES=1500000  # skip files larger than this

# --- blast radius -----------------------------------------------------------
# PRGRAF_MAX_IMPACT_NODES=500    # cap on impacted nodes returned
# PRGRAF_MAX_IMPACT_DEPTH=2      # hops to traverse
# PRGRAF_IMPACT_DEPTH_DECAY=0.6  # score multiplier per hop, in (0, 1)
# PRGRAF_IMPACT_SCORE_FLOOR=0.05 # prune below this score
